{
  "name": "juju-desktop-pet",
  "version": "1.2.0",
  "description": "啾莉恩桌宠 - desktop pet",
  "main": "main.js",
  "author": "uuno-123",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "com.lx.juju-desktop-pet",
    "productName": "Juju桌宠",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "pet.js",
      "reminder.html",
      "todo.html",
      "pomo-input.html",
      "lines-editor.html",
      "cycle-editor.html",
      "star.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/audio_watch.exe",
        "to": "audio_watch.exe"
      },
      {
        "from": "tools/fullscreen_watch.ps1",
        "to": "fullscreen_watch.ps1"
      },
      {
        "from": "tools/desk_action.ps1",
        "to": "desk_action.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "啾莉恩桌宠"
    },
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ]
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
