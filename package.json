{
  "name": "juju-desktop-pet",
  "version": "1.1.2",
  "description": "啾莉恩桌宠 - desktop pet",
  "main": "main.js",
  "author": "uuno-123",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "com.lx.juju-desktop-pet",
    "productName": "Juju桌宠",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "pet.js",
      "reminder.html",
      "pomo-input.html",
      "lines-editor.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/audio_watch.exe",
        "to": "audio_watch.exe"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "啾莉恩桌宠"
  }
  }
}
